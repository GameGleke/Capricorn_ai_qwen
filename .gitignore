# личные настройки (создаются при первом запуске из настроек по умолчанию в main.py)
config.json

# скачиваемая модель распознавания речи — ставится через setup.bat
models/

# журнал, отчёты диагностики, образцы голоса — личные данные
capri.log
reports/
samples/

# служебное
__pycache__/
*.pyc
*.tmp

# локальные артефакты Steam-запуска (не относятся к проекту)
sclauncher.log
sc_country_cache
sc_realm_cache

# веса моделей Hugging Face (качаются в ~6 ГБ, в git не нужны)
hf_models/
hf_cache/

# GGUF-веса llama.cpp (~5 ГБ, качаются один раз)
gguf_models/
